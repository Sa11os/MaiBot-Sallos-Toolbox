                      "required": true,
                      "max_length": 2000
                    },
                    "card": {
                      "type": "string",
                      "required": true,
                      "max_length": 2000
                    }
                  }
                }
              }
            }
          },
          "confirmation": "所有 Dashboard 浏览器将预览此风格 20 秒，随后自动恢复。继续？"
        },
        "reset": {
          "api": "appearance_reset",
          "confirmation": "恢复此服务器的原有 Dashboard 外观？"
        },
