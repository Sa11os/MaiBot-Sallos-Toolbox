                      "required": true,
                      "max_length": 2000
                    },
                    "card": {
                      "type": "string",
                      "required": true,
                      "max_length": 2000
                    }
                  }
                }
              }
            },
            "preset_id": {
              "type": "string",
              "required": true,
              "max_length": 32
            },
            "revision": {
              "type": "integer",
              "required": true,
              "minimum": 0
            }
          }
        },
        "delete": {
          "api": "appearance_delete",
          "parameters": {
