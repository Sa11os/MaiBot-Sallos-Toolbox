                },
                "radius": {
                  "type": "integer",
                  "required": true,
                  "minimum": 0,
                  "maximum": 24
                },
                "shadow": {
                  "type": "string",
                  "required": true,
                  "choices": [
                    "none",
                    "soft",
                    "crisp"
                  ]
                },
                "regions": {
                  "type": "object",
