{
  "manifest_version": 2,
  "id": "sallos.toolbox",
  "version": "0.2.3",
  "name": "Sallos 工具箱",
  "description": "模块化 MaiBot 工具箱：全站外观与布局定制、预设管理、连通检查。自带 Dashboard 1.9.9 静态资源适配与恢复。",
  "author": {
    "name": "Sallos",
    "url": "https://github.com/Sa11os"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/Sa11os/MaiBot-Sallos-Toolbox",
    "issues": "https://github.com/Sa11os/MaiBot-Sallos-Toolbox/issues"
  },
  "host_application": {
    "min_version": "1.3.15",
    "max_version": "1.3.99"
  },
  "sdk": {
    "min_version": "2.16.0",
    "max_version": "2.99.99"
  },
  "dependencies": [],
  "plugin_type": "tool",
  "capabilities": ["send.text"],
  "i18n": {
    "default_locale": "zh-CN"
  }
}
